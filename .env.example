# AgriSure Environment Variables Configuration Example
DJANGO_SECRET_KEY=your-production-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite in local dev, Postgres in production)
# DATABASE_URL=postgres://agrisure_user:password@localhost:5432/agrisure_db

# Razorpay / Payment Gateway Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here

# Redis Channel Layer for Production WebSockets (In-memory used in dev)
# REDIS_URL=redis://127.0.0.1:6379/1
